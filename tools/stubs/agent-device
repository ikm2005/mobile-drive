#!/usr/bin/env bash
# Fake agent-device for the tests: no device, no daemon. Put tools/stubs first on PATH.
#
# Every call appends its argv as one line to $STUB_LOG (when set). Behaviour per scenario:
#   STUB_SNAPSHOT=<file>        `snapshot --json` prints this file
#   STUB_SNAPSHOT_FAIL=1        `snapshot` fails
#   STUB_SCREENSHOT=<png>       `screenshot <path>` copies this file to <path> (unset: the call fails)
#   STUB_SCREENSHOT_FAIL=1      `screenshot` fails
#   STUB_SCREENSHOT_NO_RECORD=reject   `screenshot … --no-record` fails as an unknown flag
#   STUB_DIFF_JSON=<text>       what `diff screenshot … --json` prints (default: 0% mismatch)
#   STUB_REPLAY=diverge         `replay` prints $STUB_REPLAY_REPORT (default fixture) and exits 1
#   STUB_REPLAY=timeout         `replay` prints the daemon's time-limit error and exits 1
#   STUB_REPLAY_COPY=<file>     `replay <flow>` copies the flow it was given here
#   STUB_OPEN=in_use            `open` prints the DEVICE_IN_USE error and hint and exits 1
#   STUB_ALERT=1                `alert get` reports an alert until `alert dismiss`
#   STUB_EXISTS=<lines>         selectors that `is exists` finds (one per line) until each is pressed
# State between calls (dismissed alert, pressed selectors) lives next to the log: $STUB_LOG.state/.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ -n "${STUB_LOG:-}" ]] && printf '%s\n' "$*" >> "$STUB_LOG"
state="${STUB_LOG:+$STUB_LOG.state}"
[[ -n "$state" ]] && mkdir -p "$state"

has_flag() { local want="$1"; shift; local x; for x in "$@"; do [[ "$x" == "$want" ]] && return 0; done; return 1; }

cmd="${1:-}"; shift || true
case "$cmd" in
  ""|--help|help)
    echo "agent-device (test stub)"; exit 0 ;;
  snapshot)
    if [[ -n "${STUB_SNAPSHOT_FAIL:-}" ]]; then echo "Error: no active session on this device" >&2; exit 1; fi
    [[ -f "${STUB_SNAPSHOT:-}" ]] || { echo "Error: stub has no STUB_SNAPSHOT" >&2; exit 1; }
    cat "$STUB_SNAPSHOT"; exit 0 ;;
  screenshot)
    dst="${1:-}"
    if [[ -n "${STUB_SCREENSHOT_FAIL:-}" ]]; then echo "Error: screenshot failed" >&2; exit 1; fi
    if [[ "${STUB_SCREENSHOT_NO_RECORD:-}" == reject ]] && has_flag --no-record "$@"; then
      echo "Error: unknown flag --no-record for screenshot" >&2; exit 1
    fi
    [[ -n "$dst" && -f "${STUB_SCREENSHOT:-}" ]] || { echo "Error: stub has no STUB_SCREENSHOT" >&2; exit 1; }
    cp "$STUB_SCREENSHOT" "$dst" && echo "Saved screenshot: $dst"; exit $? ;;
  diff)
    same='{"success": true, "data": {"mismatchPercentage": 0, "dimensionMismatch": false}}'
    printf '%s\n' "${STUB_DIFF_JSON:-$same}"
    exit 0 ;;
  open)
    if [[ "${STUB_OPEN:-}" == in_use ]]; then
      echo 'Error (DEVICE_IN_USE): Device is already in use by workspace session "cwd:0123abcd:android"'
      echo 'Hint: Session "cwd:0123abcd:android" belongs to another workspace. Run agent-device close --session cwd:0123abcd:android to release this device from that workspace.'
      echo "Diagnostic ID: stub-0001"
      echo "Diagnostics Log: /tmp/stub-diagnostics.log"
      exit 1
    fi
    exit 0 ;;
  replay)
    [[ -n "${STUB_REPLAY_COPY:-}" && -f "${1:-}" ]] && cp "$1" "$STUB_REPLAY_COPY"
    if [[ "${STUB_REPLAY:-pass}" == diverge ]]; then
      cat "${STUB_REPLAY_REPORT:-$here/../fixtures/replay-diverged.txt}"; exit 1
    fi
    if [[ "${STUB_REPLAY:-pass}" == timeout ]]; then
      echo "Error (COMMAND_FAILED): Daemon request timed out"
      echo "Hint: Retry with --debug and check daemon diagnostics logs."; exit 1
    fi
    echo "Replay passed: $(basename "${1:-flow}")"; exit 0 ;;
  alert)
    sub="${1:-get}"
    if [[ "$sub" == dismiss || "$sub" == accept ]]; then
      [[ -n "$state" ]] && : > "$state/alert-dismissed"; echo "Alert dismissed"; exit 0
    fi
    if [[ -n "${STUB_ALERT:-}" && ! -e "${state:-/nonexistent}/alert-dismissed" ]]; then
      if has_flag --json "$@"; then echo '{"success": true, "data": {"title": "Allow notifications?"}}'
      else echo 'Alert: "Allow notifications?" [Allow] [Don'"'"'t Allow]'; fi
    else
      if has_flag --json "$@"; then echo '{"success": true, "data": {"alert": null}}'
      else echo "No active alert"; fi
    fi
    exit 0 ;;
  is)
    pred="${1:-}"; sel="${2:-}"
    [[ "$pred" == exists && -n "$sel" ]] || exit 1
    printf '%s\n' "${STUB_EXISTS:-}" | grep -Fxq -- "$sel" || exit 1
    [[ -n "$state" && -f "$state/pressed" ]] && grep -Fxq -- "$sel" "$state/pressed" && exit 1
    exit 0 ;;
  press)
    [[ -n "$state" ]] && printf '%s\n' "${1:-}" >> "$state/pressed"; exit 0 ;;
  *)
    exit 0 ;;  # open, close, wait, fill, …: succeed silently
esac
